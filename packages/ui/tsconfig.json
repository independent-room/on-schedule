{
  "extends": "@on-schedule/tsconfig/library.json",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@on-schedule/ui/*": ["./src/*"]
    },
    "jsx": "preserve",
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
