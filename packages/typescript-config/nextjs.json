{
  "$schema": "https://json.schemastore.org/tsconfig",
  "display": "Next.js 15 — apps/web",
  "extends": "./base.json",
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["DOM", "DOM.Iterable", "ES2022"],

    "jsx": "preserve",
    "allowJs": true,
    "noEmit": true,

    "plugins": [{ "name": "next" }],

    "types": ["node"]
  },
  "include": [
    "next-env.d.ts",
    ".next/types/**/*.ts",
    "**/*.ts",
    "**/*.tsx"
  ]
}
