{
  "name": "@on-schedule/tailwind-config",
  "version": "0.0.0",
  "private": true,
  "description": "온스케줄 공유 Tailwind 설정 (카라멜 팔레트 + web/native preset)",
  "main": "./index.ts",
  "types": "./index.ts",
  "exports": {
    ".": "./index.ts",
    "./colors": "./colors.ts",
    "./theme": "./theme.ts",
    "./web": "./web.ts",
    "./native": "./native.ts",
    "./globals.css": "./globals.css"
  },
  "files": [
    "colors.ts",
    "theme.ts",
    "web.ts",
    "native.ts",
    "index.ts",
    "globals.css"
  ],
  "peerDependencies": {
    "tailwindcss": "^3.4.0"
  },
  "peerDependenciesMeta": {
    "nativewind": {
      "optional": true
    }
