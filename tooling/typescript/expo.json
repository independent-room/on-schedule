{
  "$schema": "https://json.schemastore.org/tsconfig",
  "display": "Expo SDK 53 — apps/mobile",
  "extends": "./base.json",
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022"],

    "jsx": "react-native",
    "allowJs": true,
    "noEmit": true,

    "types": ["node", "react", "react-native"]
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts"
  ]
}
