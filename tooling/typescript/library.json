{
  "$schema": "https://json.schemastore.org/tsconfig",
  "display": "Library — packages/* (shared, api-client 등)",
  "extends": "./base.json",
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022"],

    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "noEmit": false,

    "composite": false
  }
}
