# 사용법:
#   1. cp apps/web/.env.example apps/web/.env.local
#   2. 아래 빈 값을 Bitwarden Secure Note "On-Schedule .env.local"에서 복사
#   3. .env.local은 .gitignore되어 있음 (git에 절대 안 올라감)
#
# 배포 환경 (Vercel):
#   Vercel Dashboard → Settings → Environment Variables 에 동일하게 등록
#   또는 vercel env add SUPABASE_SECRET_KEY production

# ─────────────────────────────────────────────
# Supabase (Project: on-schedule, region: ap-southeast-2)
# ─────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://vgstjcjaeydzkljcboio.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_tLDxy2h4R7outtLyiG1G8A_r7meqAhM
# ⚠️ 서버 전용. 절대 NEXT_PUBLIC_ prefix 금지. 클라이언트 노출 시 DB 전체 무방비.
SUPABASE_SECRET_KEY=

# ─────────────────────────────────────────────
# Resend (API key: on-schedule-production, Sending access only)
# ─────────────────────────────────────────────
RESEND_API_KEY=

# ─────────────────────────────────────────────
# 발신 메일 주소 (Resend로 발송, Cloudflare Email Routing으로 답장 수신)
# ─────────────────────────────────────────────
RESEND_FROM_EMAIL=contact@send.onschedule.kr
RESEND_REPLY_TO=contact@onschedule.kr
